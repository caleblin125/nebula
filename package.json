{
  "name": "nebula",
  "private": true,
  "version": "0.1.0",
  "description": "Seeded procedural nebula generator rendered with WebGL2 and GLSL ES 3.00.",
  "keywords": [
    "webgl2",
    "glsl",
    "shaders",
    "procedural-generation",
    "nebula",
    "raymarching",
    "typescript",
    "vite"
  ],
  "author": "Caleb Lin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caleblin125/nebula.git"
  },
  "homepage": "https://github.com/caleblin125/nebula#readme",
  "bugs": {
    "url": "https://github.com/caleblin125/nebula/issues"
  },
  "type": "module",
  "main": "./dist-lib/nebula.cjs",
  "module": "./dist-lib/nebula.js",
  "types": "./dist-lib/types/library/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/library/index.d.ts",
      "import": "./dist-lib/nebula.js",
      "require": "./dist-lib/nebula.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist-lib/",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:demo && npm run build:lib",
    "build:demo": "tsc --noEmit && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "bench": "vite --open /bench.html"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
